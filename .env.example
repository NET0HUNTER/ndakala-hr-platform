# Copy to .env for production/local deployment. NEVER commit real secrets.
# Production PostgreSQL 16 (isolated internal Docker container ndakala_hr-db on ndakala-hr-net)
POSTGRES_USER="ndakala_hr"
POSTGRES_PASSWORD="replace_with_openssl_rand_hex_24"
POSTGRES_DB="ndakala_hr"
DATABASE_URL="postgresql://ndakala_hr:replace_with_openssl_rand_hex_24@ndakala_hr-db:5432/ndakala_hr?schema=public"
# Optional SQLite override for isolated Vitest/CI runs: DATABASE_URL="file:./dev.db"
# 64 hex chars (32 bytes, via: openssl rand -hex 32). REQUIRED in production.
ENCRYPTION_MASTER_KEY=""
# Keyed HMAC secret for duplicate detection of national IDs (64 hex chars). REQUIRED in production.
IDENTIFIER_HASH_SECRET=""
# Signed download token secret (64 hex chars). REQUIRED in production.
DOWNLOAD_TOKEN_SECRET=""
# Initial bootstrap password for seeded RBAC accounts (change immediately after first login)
INITIAL_ADMIN_PASSWORD=""
# DuckDNS update token (optional, for automated DNS check/update scripts)
DUCKDNS_TOKEN=""
# Employee number prefix
EMPLOYEE_NUMBER_PREFIX="NDA"
# Background job interval in minutes (expiry scans, probation reminders, onboarding escalation). 0 disables.
LIFECYCLE_JOB_INTERVAL_MINUTES="60"
PORT="4000"
NODE_ENV="production"
